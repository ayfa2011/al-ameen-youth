rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /profile-photos/{userId}/avatar.jpg {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size <= 512 * 1024
                   && request.resource.contentType == 'image/jpeg';
    }

    match /program-reports/{reportId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    match /quiz-media/{roomId}/{questionId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && (request.auth.token.email == 'kebir.limra@gmail.com'
                       || request.auth.token.email == 'ayfaramboor@gmail.com')
                   && request.auth.token.googleAuth == true
                   && request.resource.size <= 10 * 1024 * 1024
                   && request.resource.contentType.matches('^(image/(jpeg|png|webp|gif)|audio/(mpeg|mp4|ogg|wav|webm|aac|x-m4a))$');
    }
  }
}
